# Servidor
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# IA - implementação inicial: OpenAI
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-luna
AI_QUALITY_MODEL=gpt-5.6-terra
AI_ROUTER_MODEL=gpt-5.6-luna
AI_API_KEY=

# Se true, perguntas realmente ambíguas podem usar um modelo pequeno só para classificar.
# O padrão false economiza uma chamada; o executor final resolve a maioria das ambiguidades.
ROUTER_LLM_ENABLED=false
ROUTER_LLM_CONFIDENCE_THRESHOLD=0.58

# Pesquisa web - implementação inicial: Brave Search API
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_COUNTRY=BR
WEB_SEARCH_LANG=pt-br
